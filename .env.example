# copy to .env. never commit .env.
CRAWLER_ENV=dev
CRAWLER_DATABASE_URL=postgres://crawler:crawler-dev-only@127.0.0.1:5441/crawler?sslmode=disable
CRAWLER_HTTP_ADDR=127.0.0.1:8080
CRAWLER_METRICS_ADDR=127.0.0.1:9091
# origin of the web ui. CSRF origin check.
CRAWLER_PUBLIC_URL=http://localhost:5173
# cidrs whose X-Forwarded-For is trusted (ingress). empty = none.
CRAWLER_TRUSTED_PROXIES=
# CRAWLER_DB_MAX_CONNS=8
# CRAWLER_SESSION_TTL=168h
# CRAWLER_SESSION_IDLE_TTL=24h
# CRAWLER_COOKIE_SECURE=true   (default true in prod)
# CRAWLER_PASSWORD_HASH_CONCURRENCY=4
# `crawler admin create` reads the password from here or stdin. never pass it as an argument.
# CRAWLER_ADMIN_PASSWORD=
# CRAWLER_RATE_LIMIT=on

# worker
# CRAWLER_WORKER_CONCURRENCY=2
# CRAWLER_WORKER_HEALTH_ADDR=127.0.0.1:8081

# crawl tuning (defaults = java crawler)
CRAWLER_RAW_DATA_DIR=./data/raw
# CRAWLER_DISCOVERY_MAX_PAGES=50
# CRAWLER_EXTRACTION_BATCH_SIZE=10
# CRAWLER_RETRY_MAX=3
# CRAWLER_RETRY_INTERVAL=10m
# CRAWLER_STUCK_AFTER=30m
# CRAWLER_FETCH_TIMEOUT=15s
# CRAWLER_RENDER_TIMEOUT=30s
# CRAWLER_USER_AGENT=
# headless chrome. empty path -> found on PATH.
# CRAWLER_CHROME_PATH=
# CRAWLER_BROWSER_PROFILE_DIR=./data/profile
# CRAWLER_HEADLESS=true
